[Unit]
Description=fail if sleep delay inhibitor locks are held
Before=systemd-suspend.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/check-inhibitors

[Install]
RequiredBy=systemd-suspend.service
